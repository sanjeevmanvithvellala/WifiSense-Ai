# WiFiSense AI Environment Variables
# Backend Configuration
PROJECT_NAME=WiFiSense AI
API_V1_STR=/api
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration (SQLite for local, PostgreSQL ready)
DATABASE_URL=sqlite:///./wifisense.db

# Storage Paths
DATA_DIR=./data
MODELS_DIR=./models/registry
LOG_LEVEL=INFO

# WebSocket & Replay Configuration
DEFAULT_REPLAY_SAMPLE_RATE_HZ=50
MAX_BUFFER_SIZE=1000

# Security & Safety
SECRET_KEY=wifisense-ai-insecure-dev-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440
